NODE_ENV=development
PORT=3000

# MySQL is required for login and MIS data.
DATABASE_URL=mysql://root:password@localhost:3306/college_mis

# Development-only local roles. Production always disables local sign-in.
LOCAL_AUTH_ENABLED=true
VITE_LOCAL_AUTH_ENABLED=true
JWT_SECRET=replace-with-a-random-secret-before-deployment
OWNER_EMAIL=administrator@example.edu

# Institutional OpenID Connect / OAuth 2.0 provider (needed for institutional sign-in).
OAUTH_AUTHORIZATION_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:3000/api/oauth/callback
OAUTH_SCOPE=openid profile email
OAUTH_SUBJECT_NAMESPACE=

# S3-compatible object storage (needed for student document uploads).
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
